  "narrative": {
    "northStar": "The care register",
    "overview": "SlotZero uses a forest-green shell and pale green work areas to frame a readable scheduling tool. Names, dates and paired local times carry the hierarchy. The identity is expressed through type, restrained color and aligned rows rather than decorative medical imagery.\n\nThe system is light-theme only. Flat work surfaces, visible field boundaries and compact summaries support repeated tasks; account screens reuse the same palette and type at a larger scale. Product truth remains in PRODUCT.md and the canonical project documents. This file records the built visual system, whose implementation source is slotzero-mvp/static/tokens.css, base.css and styles.css; it does not introduce a second token implementation.",
    "keyCharacteristics": [
      "Forest shell, light work surfaces and one deep-green action color.",
      "Lexend headings with readable Source Sans 3 controls and content.",
      "Aligned appointment rows with explicit time-zone names.",
      "Flat containers, clear boundaries and state-driven motion."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Confirmation, failure and selection remain understandable without color.",
        "section": "colors"
      },
      {
        "name": "The Reading First Rule",
        "body": "Preserve complete names, dates and zone names; wrap supporting text rather than silently clipping it.",
        "section": "typography"
      },
      {
        "name": "The Flat Workbench Rule",
        "body": "Use surface tone and dividers for work areas; reserve the floating shadow for an overlay.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the shipped CSS tokens and the same input and button variants on every screen.",
      "Do keep full time-zone labels and paired appointment times readable at mobile widths.",
      "Do retain visible labels, immediate focus indicators and meaningful status text.",
      "Do use light surfaces, green-black navigation and flat ruled work areas consistently."
    ],
    "donts": [
      "Don't introduce a competing palette, font system or unimplemented dark theme.",
      "Don't replace live appointment data with invented metrics, testimonials or mock bookings.",
      "Don't use tracked-cap eyebrows, decorative glyph icons or nested cards.",
      "Don't hide content behind entrance effects or remove state feedback for reduced-motion users."
    ]
  }
}
