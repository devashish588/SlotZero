  "narrative": {
    "northStar": "The restored navy workspace",
    "overview": "On 2026-11-01 the user explicitly rejected the green care-register redesign and requested the previous navy/card design back, with larger readable fonts and targeted functional updates. That reversal supersedes the former green direction and its surface contract. Preserve the restored compositions rather than treating the earlier redesign as authority.\n\nThe implementation source is slotzero-mvp/static/styles.css, restored from 2df0d49 with its readable font floor, followed by enhancements.css for local fonts, readability and new widgets. This document extracts that effective cascade. Frontmatter entries matching root variables keep their existing names; component-specific literal colors remain descriptive snapshots, not a competing CSS token implementation. This is a light-theme site, with a dark navy navigation rail rather than a dark-mode option.",
    "keyCharacteristics": [
      "Navy navigation, pale gray work background and white rounded cards.",
      "Green primary actions with lavender and amber accents retained in the original cards.",
      "Local Lexend headings and Source Sans 3 body content.",
      "Existing screen compositions plus focused navigation, schedule and update widgets."
    ],
    "rules": [
      {
        "name": "The Restored Identity Rule",
        "body": "Keep the navy/card compositions; targeted usability changes must not reintroduce the rejected green visual world.",
        "section": "colors"
      },
      {
        "name": "The Readable Task Rule",
        "body": "Keep entry fields at 16px and preserve readable appointment, zone and schedule details; do not shrink task text to fit decoration.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve the user's restored navy shell, card grid and screen compositions.",
      "Do layer narrow readability and widget styles through enhancements.css after styles.css.",
      "Do use the locally served Lexend and Source Sans 3 fonts with reliable fallbacks.",
      "Do keep split shifts, update state and calendar setup status explicit and truthful."
    ],
    "donts": [
      "Don't reapply the rejected green care-register direction or its flat-row layouts.",
      "Don't describe manual calendar export as automatic live synchronization.",
      "Don't claim complete contrast compliance or live OAuth verification from source inspection.",
      "Don't let UI changes alter the validated scheduling rules or booking authority."
    ]
  }
}
