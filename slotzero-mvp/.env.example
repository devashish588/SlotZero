# Copy to .env and adjust before deployment.
SLOTZERO_DB_PATH=./slotzero.db
# Set true behind HTTPS in production.
SLOTZERO_COOKIE_SECURE=false

# Optional Google Calendar export. Keep all secrets in .env, never in Git.
# Register this exact callback for an OAuth "Web application" client.
SLOTZERO_GOOGLE_CLIENT_ID=
SLOTZERO_GOOGLE_CLIENT_SECRET=
SLOTZERO_GOOGLE_REDIRECT_URI=http://localhost:8000/doctor/calendar/callback
# Generate once: py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SLOTZERO_GOOGLE_TOKEN_KEY=
